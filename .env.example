# 복사해서 .env로 만들고 값을 채운다. .env는 git에 올리지 않는다.
# 앱에는 URL과 publishable key만 넣는다. secret key·service_role 키는 절대 넣지 않는다.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 구글 로그인: Google Cloud 콘솔의 OAuth 클라이언트 ID(비밀값 아님)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# 카카오 로그인: 카카오 디벨로퍼스 > 앱 설정 > 앱 > 플랫폼 키의 네이티브 앱 키(앱에 포함되는 공개 키)
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# Android Firebase 앱 설정 파일 경로. FCM V1 서비스 계정 키와는 다른 파일이다.
# EAS에서는 파일 환경변수로 등록할 수 있다.
# GOOGLE_SERVICES_JSON=./google-services.json

# Amplitude: 프로젝트 설정의 API Key(앱에 포함되는 공개 키). 비우면 분석을 수집하지 않는다.
EXPO_PUBLIC_AMPLITUDE_API_KEY=
