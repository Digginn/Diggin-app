# 복사해서 supabase/.env로 만들고 값을 채운다. supabase/.env는 git에 올리지 않는다.
# 로컬 Supabase(supabase start)가 config.toml의 env(...) 자리에 이 값을 넣는다.

# 카카오: REST API 키,네이티브 앱 키 (쉼표 구분, REST API 키가 먼저)
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=

# 구글: 웹 클라이언트 ID,iOS 클라이언트 ID (쉼표 구분, 웹이 먼저) / 웹 클라이언트 Secret
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# 애플: iOS 번들 ID. Secret은 Android 애플 로그인을 붙일 때 넣는다.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=com.diggin.app.preview
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
